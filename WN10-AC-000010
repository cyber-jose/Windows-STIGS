<#
.SYNOPSIS
    Configures the number of allowed bad logon attempts to 3 or fewer, in compliance with STIG WN10-AC-000010.

.NOTES
    Author          : Jose Camacho
    GitHub          : github.com/cyber-jose
    Date Created    : 2025-04-30
    Last Modified   : 2025-04-30
    Version         : 1.0
    STIG-ID         : WN10-AC-000010

.TESTED ON
    Date(s) Tested  : 2025-04-30
    Tested By       : Jose Camacho
    Systems Tested  : Windows 10 Pro 22H2, Windows 10 Enterprise
    PowerShell Ver. : 5.1

.USAGE
    Run this script as administrator to configure bad logon attempts:
    PS C:\> .\Fix-WN10-AC-000010.ps1
#>
#Requires -RunAsAdministrator

# Local security policy registry key for bad logon attempts
$registryPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"
$propertyName = "MaxBadPasswordsBeforeLock"
$desiredValue = 3

# Check if the registry key exists
if (-Not (Test-Path $registryPath)) {
    New-Item -Path $registryPath -Force | Out-Null
}

# Set the registry value for maximum bad logon attempts
Set-ItemProperty -Path $registryPath -Name $propertyName -Value $desiredValue -Type DWord

# Apply the new setting
Write-Host "✔ Configured bad logon attempts to $desiredValue"
