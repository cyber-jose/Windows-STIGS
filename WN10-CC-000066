<#
.SYNOPSIS
    Enables command-line data inclusion in process creation events per STIG WN10-CC-000066.

.NOTES
    Author          : Jose Camacho  
    GitHub          : github.com/cyber-jose  
    Date Created    : 2025-05-02
    Last Modified   : 2025-05-02  
    Version         : 1.0  
    STIG-ID         : WN10-CC-000066

.TESTED ON
    Date(s) Tested  : 2025-05-02
    Tested By       : Jose Camacho  
    Systems Tested  : Windows 10 Pro 22H2, Windows 10 Enterprise  
    PowerShell Ver. : 5.1  

.USAGE
    Run this script as administrator to enable command line auditing in process creation:
    PS C:\> .\Fix-WN10-CC-000066.ps1
#>
#Requires -RunAsAdministrator

# Registry path and value for enabling command line in process creation events
$regPath = "HKLM:\Software\Microsoft\Windows\CurrentVersion\Policies\System\Audit"
$regName = "ProcessCreationIncludeCmdLine_Enabled"
$desiredValue = 1

# Ensure registry path exists
if (-Not (Test-Path $regPath)) {
    New-Item -Path $regPath -Force | Out-Null
}

# Set the policy value
Set-ItemProperty -Path $regPath -Name $regName -Value $desiredValue -Type DWord

Write-Host "✔ Command-line auditing in process creation events enabled (STIG WN10-CC-000066)." -ForegroundColor Green
