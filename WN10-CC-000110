<#
.SYNOPSIS
    Disables printing over HTTP in compliance with STIG WN10-CC-000110.

.NOTES
    Author          : Jose Camacho  
    GitHub          : github.com/cyber-jose  
    Date Created    : 2025-05-01  
    Last Modified   : 2025-05-01  
    Version         : 1.0  
    STIG-ID         : WN10-CC-000110  

.TESTED ON
    Date(s) Tested  : 2025-05-01  
    Tested By       : Jose Camacho  
    Systems Tested  : Windows 10 Pro 22H2, Windows 10 Enterprise  
    PowerShell Ver. : 5.1  

.USAGE
    Run this script as administrator to disable printing over HTTP:
    PS C:\> .\Fix-WN10-CC-000110.ps1
#>
#Requires -RunAsAdministrator

# Define the registry path and policy name
$regPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Printers"
$policyName = "DisableHTTPPrinting"
$desiredValue = 1  # 1 = Enabled (turn off printing over HTTP)

# Ensure the registry path exists
if (-Not (Test-Path $regPath)) {
    New-Item -Path $regPath -Force | Out-Null
}

# Set the policy to disable printing over HTTP
Set-ItemProperty -Path $regPath -Name $policyName -Value $desiredValue -Type DWord

Write-Host "✔ Printing over HTTP has been disabled (STIG WN10-CC-000110)." -ForegroundColor Green
