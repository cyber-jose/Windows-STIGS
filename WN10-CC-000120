<#
.SYNOPSIS
    Hides the network selection UI on the Windows logon screen to comply with STIG WN10-CC-000120.

.NOTES
    Author          : Jose Camacho
    GitHub          : github.com/cyber-jose
    Date Created    : 2025-05-01
    Last Modified   : 2025-05-01
    Version         : 1.0
    STIG-ID         : WN10-CC-000120

.TESTED ON
    Date(s) Tested  : 2025-05-01
    Tested By       : Jose Camacho
    Systems Tested  : Windows 10 Pro 22H2, Windows 10 Enterprise
    PowerShell Ver. : 5.1

.USAGE
    Run this script as administrator to disable the network selection UI on the logon screen:
    PS C:\> .\Fix-WN10-CC-000120.ps1
#>
#Requires -RunAsAdministrator

# Define the registry path and policy key
$regPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System"
$policyName = "DontDisplayNetworkSelectionUI"
$desiredValue = 1  # 1 = Enabled (do not display network selection UI)

# Ensure the registry path exists
if (-Not (Test-Path $regPath)) {
    New-Item -Path $regPath -Force | Out-Null
}

# Set the policy to hide the network selection UI on the logon screen
Set-ItemProperty -Path $regPath -Name $policyName -Value $desiredValue -Type DWord

Write-Host "✔ Network selection UI has been hidden from the logon screen (STIG WN10-CC-000120)." -ForegroundColor Green
