<#
.SYNOPSIS
    Ensures password prompt is required on resume from sleep while on battery power, in accordance with STIG WN10-CC-000145.

.NOTES
    Author          : Jose Camacho
    GitHub          : github.com/cyber-jose
    Date Created    : 2025-04-30
    Last Modified   : 2025-04-30
    Version         : 1.1
    STIG-ID         : WN10-CC-000145

.TESTED ON
    Date(s) Tested  : 2025-04-30
    Tested By       : Jose Camacho
    Systems Tested  : Windows 10 Pro 22H2, Windows 10 Enterprise
    PowerShell Ver. : 5.1

.USAGE
    Run this script as administrator to enforce the battery power resume password requirement:
    PS C:\> .\Fix-WN10-CC-000145.ps1
#>
#Requires -RunAsAdministrator

# Configure Group Policy setting for "Require a password when a computer wakes (on battery)"
$gpSettingPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System"
$policyName = "RequirePasswordOnWake"
$desiredValue = 1  # Enabling the password prompt for battery power (DC)

# Check if the registry key exists
if (-Not (Test-Path $gpSettingPath)) {
    New-Item -Path $gpSettingPath -Force | Out-Null
}

# Enable the policy to require a password on wake for battery power
Set-ItemProperty -Path $gpSettingPath -Name $policyName -Value $desiredValue -Type DWord

# Apply the new setting (enabling password on wake from sleep on battery)
Write-Host "✔ Configured password prompt requirement on wake (battery power)."
