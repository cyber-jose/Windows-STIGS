<#
.SYNOPSIS
    Ensures password prompt is required on resume from sleep while on AC power, in accordance with STIG WN10-CC-000150.

.NOTES
    Author          : Jose Camacho
    GitHub          : github.com/cyber-jose
    Date Created    : 2025-04-30
    Last Modified   : 2025-04-30
    Version         : 1.4
    STIG-ID         : WN10-CC-000150

.TESTED ON
    Date(s) Tested  : 2025-04-30
    Tested By       : Jose Camacho
    Systems Tested  : Windows 10 Pro 22H2, Windows 10 Enterprise
    PowerShell Ver. : 5.1

.USAGE
    Run this script as administrator to enforce the AC power resume password requirement:
    PS C:\> .\Fix-WN10-CC-000150.ps1
#>
#Requires -RunAsAdministrator

# Registry path for "Require a password on wake"
$gpSettingPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"
$policyName = "RequirePasswordOnWake"
$desiredValue = 1  # Enabling the password prompt for AC power

# Check if the registry key exists
if (-Not (Test-Path $gpSettingPath)) {
    New-Item -Path $gpSettingPath -Force | Out-Null
}

# Enable the policy to require a password on wake for AC power
Set-ItemProperty -Path $gpSettingPath -Name $policyName -Value $desiredValue -Type DWord

# Apply the new setting (enabling password on wake from sleep on AC)
Write-Host "✔ Configured password prompt requirement on wake (AC power)."
