<#
.SYNOPSIS
    Disables Microsoft consumer experiences in accordance with STIG WN10-CC-000197.

.NOTES
    Author          : Jose Camacho
    GitHub          : github.com/cyber-jose
    Date Created    : 2025-05-02
    Last Modified   : 2025-05-02
    Version         : 1.0
    STIG-ID         : WN10-CC-000197

.TESTED ON
    Date(s) Tested  : 2025-05-02
    Tested By       : Jose Camacho
    Systems Tested  : Windows 10 Pro 22H2, Windows 10 Enterprise
    PowerShell Ver. : 5.1

.USAGE
    Run this script as administrator to disable Microsoft consumer experiences:
    PS C:\> .\Fix-WN10-CC-000197.ps1
#>
#Requires -RunAsAdministrator

# Registry path for Cloud Content policy
$regPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\CloudContent"
$regName = "DisableConsumerAccountStateContent"
$desiredValue = 1  # 1 = Enabled (turn off experiences)

# Ensure registry path exists
if (-Not (Test-Path $regPath)) {
    New-Item -Path $regPath -Force | Out-Null
}

# Set the policy value
Set-ItemProperty -Path $regPath -Name $regName -Value $desiredValue -Type DWord

Write-Host "✔ Microsoft consumer experiences have been disabled (STIG WN10-CC-000197)." -ForegroundColor Green
