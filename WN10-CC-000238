<#
.SYNOPSIS
    Prevents certificate error overrides in Microsoft Edge, in accordance with STIG WN10-CC-000238.

.NOTES
    Author          : Jose Camacho
    GitHub          : github.com/cyber-jose
    Date Created    : 2025-05-02
    Last Modified   : 2025-05-02
    Version         : 1.0
    STIG-ID         : WN10-CC-000238

.TESTED ON
    Date(s) Tested  : 2025-05-02
    Tested By       : Jose Camacho
    Systems Tested  : Windows 10 Pro 22H2, Windows 10 Enterprise
    PowerShell Ver. : 5.1

.USAGE
    Run this script as administrator to enforce Edge certificate error override prevention:
    PS C:\> .\Fix-WN10-CC-000238.ps1
#>
#Requires -RunAsAdministrator

# Define the registry path and values
$regPath = "HKLM:\SOFTWARE\Policies\Microsoft\MicrosoftEdge\Internet Settings"
$policyName = "PreventCertErrorOverrides"
$desiredValue = 1  # 1 = Enabled

# Ensure the registry path exists
if (-Not (Test-Path $regPath)) {
    New-Item -Path $regPath -Force | Out-Null
}

# Set the policy to prevent certificate error overrides
Set-ItemProperty -Path $regPath -Name $policyName -Value $desiredValue -Type DWord

Write-Host "✔ Microsoft Edge configured to prevent certificate error overrides (STIG WN10-CC-000238)." -ForegroundColor Green
