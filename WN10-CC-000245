<#
.SYNOPSIS
    Disables the password manager feature in Microsoft Edge per STIG requirement WN10-CC-000245.

.NOTES
    Author          : Jose Camacho
    GitHub          : github.com/cyber-jose
    Date Created    : 2025-05-03
    Last Modified   : 2025-05-03
    Version         : 1.0
    STIG-ID         : WN10-CC-000245

.TESTED ON
    Date(s) Tested  : 2025-05-03
    Tested By       : Jose Camacho
    Systems Tested  : Windows 10 Pro 22H2, Windows 10 Enterprise
    PowerShell Ver. : 5.1

.USAGE
    Run this script as administrator to disable Edge password manager:
    PS C:\> .\Fix-WN10-CC-000245.ps1
#>
#Requires -RunAsAdministrator

# Registry path for Edge password manager policy
$regPath = "HKLM:\SOFTWARE\Policies\Microsoft\MicrosoftEdge\Main"
$regName = "FormSuggest Passwords"
$desiredValue = 0  # 0 = Disabled

# Ensure the registry path exists
if (-Not (Test-Path $regPath)) {
    New-Item -Path $regPath -Force | Out-Null
}

# Set the password manager policy value
Set-ItemProperty -Path $regPath -Name $regName -Value $desiredValue -Type DWord

Write-Host "✔ Password Manager in Microsoft Edge has been disabled (STIG WN10-CC-000245)." -ForegroundColor Green
