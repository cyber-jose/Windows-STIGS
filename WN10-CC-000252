<#
.SYNOPSIS
    Disables Windows Game Recording and Broadcasting in accordance with STIG requirement WN10-CC-000252.

.NOTES
    Author          : Jose Camacho  
    GitHub          : github.com/cyber-jose  
    Date Created    : 2025-05-03  
    Last Modified   : 2025-05-03  
    Version         : 1.0  
    STIG-ID         : WN10-CC-000252

.TESTED ON
    Date(s) Tested  : 2025-05-03  
    Tested By       : Jose Camacho  
    Systems Tested  : Windows 10 Pro 22H2, Windows 10 Enterprise  
    PowerShell Ver. : 5.1

.USAGE
    Run this script as administrator to disable Windows Game Recording and Broadcasting:
    PS C:\> .\Fix-WN10-CC-000252.ps1
#>
#Requires -RunAsAdministrator

# Registry path for GameDVR policy
$regPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\GameDVR"
$regName = "AllowGameDVR"
$desiredValue = 0  # 0 = Disabled

# Ensure the registry path exists
if (-Not (Test-Path $regPath)) {
    New-Item -Path $regPath -Force | Out-Null
}

# Apply the setting
Set-ItemProperty -Path $regPath -Name $regName -Value $desiredValue -Type DWord

Write-Host "✔ Windows Game Recording and Broadcasting has been disabled (STIG WN10-CC-000252)." -ForegroundColor Green
