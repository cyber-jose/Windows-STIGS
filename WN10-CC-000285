<#
.SYNOPSIS
    Ensures Remote Desktop Session Host requires secure RPC communication per STIG WN10-CC-000285.

.NOTES
    Author          : Jose Camacho  
    GitHub          : github.com/cyber-jose  
    Date Created    : 2025-05-03
    Last Modified   : 2025-05-03
    Version         : 1.0  
    STIG-ID         : WN10-CC-000285

.TESTED ON
    Date(s) Tested  : 2025-05-03
    Tested By       : Jose Camacho  
    Systems Tested  : Windows 10 Pro 22H2, Windows 10 Enterprise  
    PowerShell Ver. : 5.1

.USAGE
    Run this script as administrator to require secure RPC for RDSH:
    PS C:\> .\Fix-WN10-CC-000285.ps1
#>
#Requires -RunAsAdministrator

# Registry path for the policy
$regPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services"
$regName = "fEncryptRPCTraffic"
$desiredValue = 1  # 1 = Enabled

# Create the registry path if it doesn't exist
if (-Not (Test-Path $regPath)) {
    New-Item -Path $regPath -Force | Out-Null
}

# Apply the secure RPC policy setting
Set-ItemProperty -Path $regPath -Name $regName -Value $desiredValue -Type DWord

Write-Host "✔ Remote Desktop Session Host is now configured to require secure RPC communication (STIG WN10-CC-000285)." -ForegroundColor Green
