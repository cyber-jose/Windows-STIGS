<#
.SYNOPSIS
    Disables automatic sign-in of the last interactive user after a system-initiated restart in accordance with STIG WN10-CC-000325.

.NOTES
    Author          : Jose Camacho
    GitHub          : github.com/cyber-jose
    Date Created    : 2025-05-03
    Last Modified   : 2025-05-03
    Version         : 1.0
    STIG-ID         : WN10-CC-000325

.TESTED ON
    Date(s) Tested  : 2025-05-03
    Tested By       : Jose Camacho
    Systems Tested  : Windows 10 Pro 22H2, Windows 10 Enterprise
    PowerShell Ver. : 5.1

.USAGE
    Run this script as administrator to disable auto sign-in of last user after system-initiated restart:
    PS C:\> .\Fix-WN10-CC-000325.ps1
#>
#Requires -RunAsAdministrator

# Registry path and values to disable automatic sign-in of last interactive user
$regPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"
$regName = "DisableAutomaticRestartSignOn"
$desiredValue = 1  # 1 = Disabled (prevent auto sign-in)

# Ensure registry path exists
if (-Not (Test-Path $regPath)) {
    New-Item -Path $regPath -Force | Out-Null
}

# Apply the setting
Set-ItemProperty -Path $regPath -Name $regName -Value $desiredValue -Type DWord

Write-Host "✔ Automatic sign-in of last interactive user after restart has been disabled (STIG WN10-CC-000325)." -ForegroundColor Green
